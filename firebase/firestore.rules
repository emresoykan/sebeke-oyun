rules_version = '2';
// Şebeke arkadaş ligi. Her lig bir davet koduyla açılır: leagues/{KOD}/players/{uid} ve leagues/{KOD}/feed/{id}.
// Lig listesi okunamaz; kodu bilmeyen hiçbir şey göremez. Giriş anonimdir (Firebase Authentication, Anonymous).
// Oyuncu yalnızca kendi kaydını yazar; alanlar tip ve aralık olarak denetlenir; kayıt en fazla 10 sn'de bir güncellenir.
// Bulut kayıt: saves/{KURTARMA_KODU}. Kod 16 karakterlik rastgele bir sırdır (~80 bit); kodu bilen okur, yazar ve siler,
// liste okunamaz. Oyun durumu tek bir JSON metni olarak saklanır; boyut sınırlıdır ve en fazla 20 sn'de bir güncellenir.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function codeOk(code) { return code.matches('^[A-Z0-9]{6,16}$'); }
    function hexColor(c) { return c is string && c.matches('^#[0-9A-Fa-f]{6}$'); }
    function company(s) { return s is string && s.size() >= 1 && s.size() <= 40; }

    match /saves/{code} {
      function saveCodeOk() { return code.matches('^[A-HJ-NP-Z2-9]{16}$'); }
      function validSave(d) {
        return d.keys().hasOnly(['s', 'p', 'v', 'day', 'at'])
          && d.keys().hasAll(['s', 'v', 'day', 'at'])
          && d.s is string && d.s.size() >= 2 && d.s.size() <= 800000
          && (!('p' in d) || (d.p is string && d.p.size() <= 4000))
          && d.v is int && d.v >= 1 && d.v <= 100
          && d.day is int && d.day >= 1 && d.day <= 1000000
          && d.at == request.time;
      }
      allow get: if signedIn() && saveCodeOk();
      allow list: if false;
      allow create: if signedIn() && saveCodeOk() && validSave(request.resource.data);
      allow update: if signedIn() && saveCodeOk() && validSave(request.resource.data)
        && request.time > resource.data.at + duration.value(20, 's');
      allow delete: if signedIn() && saveCodeOk();
    }

    // Pilot geri bildirimi: feedback/{uid}. Oyuncu yalnızca kendi yanıtını yazar (en fazla 30 sn'de bir değiştirir);
    // oyundan hiç kimse okuyamaz, yanıtlar Firebase konsolundan okunur. Alanlar ve metin boyları sınırlıdır.
    match /feedback/{uid} {
      function sc(d, k) { return !(k in d) || (d[k] is int && d[k] >= 1 && d[k] <= 5); }
      function tx(d, k) { return !(k in d) || (d[k] is string && d[k].size() >= 1 && d[k].size() <= 600); }
      function validFeedback(d) {
        return d.keys().hasOnly(['v', 'role', 'exp', 'r1', 'r2', 'r3', 'u1', 'l1', 'nps', 't1', 't2', 't3',
                                  'day', 'plants', 'mw', 'techs', 'mk', 'dev', 'at'])
          && d.keys().hasAll(['v', 'role', 'exp', 'at'])
          && d.v is int && d.v >= 1 && d.v <= 100
          && d.role in ['fin', 'mkt', 'eng', 'stu', 'oth']
          && d.exp in ['0', '3', '6', '10']
          && sc(d, 'r1') && sc(d, 'r2') && sc(d, 'r3') && sc(d, 'u1') && sc(d, 'l1')
          && (!('nps' in d) || (d.nps is int && d.nps >= 0 && d.nps <= 10))
          && tx(d, 't1') && tx(d, 't2') && tx(d, 't3')
          && (!('day' in d) || (d.day is int && d.day >= 1 && d.day <= 1000000))
          && (!('plants' in d) || (d.plants is int && d.plants >= 0 && d.plants <= 10000))
          && (!('mw' in d) || (d.mw is int && d.mw >= 0 && d.mw <= 1000000))
          && (!('techs' in d) || (d.techs is string && d.techs.size() <= 80))
          && (!('mk' in d) || (d.mk is string && d.mk.size() <= 20))
          && (!('dev' in d) || d.dev in ['d', 'm'])
          && d.at == request.time;
      }
      allow get, list, delete: if false;
      allow create: if signedIn() && request.auth.uid == uid && validFeedback(request.resource.data);
      allow update: if signedIn() && request.auth.uid == uid && validFeedback(request.resource.data)
        && request.time > resource.data.at + duration.value(30, 's');
    }

    match /leagues/{code} {
      match /players/{uid} {
        function validPlayer(d) {
          return d.keys().hasOnly(['co', 'c', 'v', 'mw', 'd', 'ti', 'at'])
            && d.keys().hasAll(['co', 'c', 'v', 'mw', 'd', 'ti', 'at'])
            && company(d.co) && hexColor(d.c)
            && d.v is number && d.v >= -10000000 && d.v <= 10000000000
            && d.mw is int && d.mw >= 0 && d.mw <= 100000
            && d.d is int && d.d >= 1 && d.d <= 1000000
            && d.ti is int && d.ti >= 0 && d.ti <= 10
            && d.at == request.time;
        }
        allow get: if signedIn() && codeOk(code);
        allow list: if signedIn() && codeOk(code) && request.query.limit <= 50;
        allow create: if signedIn() && codeOk(code) && request.auth.uid == uid && validPlayer(request.resource.data);
        allow update: if signedIn() && codeOk(code) && request.auth.uid == uid && validPlayer(request.resource.data)
          && request.time > resource.data.at + duration.value(10, 's');
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      match /feed/{id} {
        function validFeed(d) {
          return d.keys().hasOnly(['uid', 'co', 'c', 'k', 'n', 'at'])
            && d.keys().hasAll(['uid', 'co', 'c', 'k', 'n', 'at'])
            && d.uid == request.auth.uid && company(d.co) && hexColor(d.c)
            && d.k in ['join', 'mw', 'val', 'goal', 'title']
            && d.n is number && d.n >= 0 && d.n <= 10000000000
            && d.at == request.time;
        }
        allow list: if signedIn() && codeOk(code) && request.query.limit <= 50;
        // yalnızca ligde kaydı olan oyuncu duyuru yazabilir; duyurular değiştirilemez ve silinemez
        allow create: if signedIn() && codeOk(code) && validFeed(request.resource.data)
          && exists(/databases/$(database)/documents/leagues/$(code)/players/$(request.auth.uid));
      }
    }
  }
}
